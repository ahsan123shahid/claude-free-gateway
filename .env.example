# Yeh file copy karke `.env` bana lein:  copy .env.example .env
# `.env` kabhi git mein commit nahi hota (.gitignore mein hai).

# --- zaroori: Experiential Labs key (https://api.experientiallabs.ai) ---
EXPERIENTIAL_API_KEY=xpl_PASTE_YOUR_KEY_HERE

# --- optional: OpenRouter free fallback (50 free req/day) ---
# Jab Experiential Labs quota khatam ho to yeh automatically use hota hai.
# Na bharein to koi baat nahi — sirf fallback rahega.
OPENROUTER_API_KEY=

# --- proxy ke andar ka local bypass key (app se match honi chahiye) ---
# Ise badalne ki zaroorat nahi; koi bhi random string chalegi.
GATEWAY_LOCAL_KEY=dummy-bypass-key

# --- optional: TokenForge free tier (https://tokenforge.ai.studio) ---
# FREE tier sirf time-window mein open hota hai (Discord par timings).
# Band waqt par model 503 dega -> proxy auto se Luna par fallback karega.
TOKENFORGE_API_KEY=
